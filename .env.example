# Configuración de Base de Datos - Servicio de Autenticación
AUTH_DB_NAME=authdb
AUTH_DB_USER=authuser
AUTH_DB_PASS=authpass
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DATABASE_URL=postgres://authuser:authpass@auth-db:5432/authdb

# Configuración de Base de Datos - Servicio de Catálogo
CATALOG_DB_NAME=catalogdb
CATALOG_DB_USER=cataloguser
CATALOG_DB_PASS=catalogpass
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DATABASE_URL=postgres://cataloguser:catalogpass@catalog-db:5432/catalogdb

# Variables de Negocio e Inter-Servicio
JWT_SECRET=cambiar-esto-en-produccion-1234567890
AUTH_SERVICE_URL=http://auth-service:8000
